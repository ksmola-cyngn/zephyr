# NXP S32K3XX MCU series

# Copyright 2023-2024 NXP
# SPDX-License-Identifier: Apache-2.0

config SOC_SERIES_S32K3
	bool
	select SOC_FAMILY_NXP_S32

config SOC_SERIES
	default "s32k3" if SOC_SERIES_S32K3

config SOC_S32K344
	bool
	select SOC_SERIES_S32K3

config SOC_S32K348
	bool
	select SOC_SERIES_S32K3

config SOC_S32K358
	bool
	select SOC_SERIES_S32K3

config SOC_S32K358_CM7_0
	bool
	select SOC_S32K358
	help
	  S32K358 Cortex-M7_0, the lockstep core. It boots from the image vector table.

config SOC_S32K358_CM7_2
	bool
	select SOC_S32K358
	help
	  S32K358 Cortex-M7_2, the core outside the lockstep pair. It does not
	  boot from the image vector table: Cortex-M7_0 starts it.

config SOC
	default "s32k344" if SOC_S32K344
	default "s32k348" if SOC_S32K348
	default "s32k358" if SOC_S32K358

config SOC_PART_NUMBER_PS32K344EHVPBS
	bool

config SOC_PART_NUMBER
	default "PS32K344EHVPBS" if SOC_PART_NUMBER_PS32K344EHVPBS
