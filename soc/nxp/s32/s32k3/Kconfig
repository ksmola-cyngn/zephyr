config SOC_SERIES_S32K3
	select ARM
	select CPU_CORTEX_M7
	select HAS_NXP_S32_HAL
	select CPU_HAS_FPU
	select CPU_HAS_ARM_MPU
	select CPU_HAS_ICACHE
	select CPU_HAS_DCACHE
	select CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS
	select SOC_EARLY_RESET_HOOK if XIP
	select USE_DT_CODE_PARTITION if XIP
	select CLOCK_CONTROL
	select HAS_MCUX
	select HAS_MCUX_CACHE
	select SOC_EARLY_INIT_HOOK
	select HAS_SEGGER_RTT if ZEPHYR_SEGGER_MODULE
	select SPI_NXP_LPSPI_ERR050456 if SPI_NXP_LPSPI

if SOC_SERIES_S32K3

config SOC_S32K3_IVT
	bool
	default y if XIP && (!BOOTLOADER_MCUBOOT || MCUBOOT) && !SOC_S32K358_CM7_2
	help
	  The image carries the image vector table the boot ROM starts the boot core from.
	  Images loaded by MCUboot and images for a core other than the boot core do not.

config SOC_S32K3_START_CM7_2
	bool "Start Cortex-M7_2"
	default y if $(dt_nodelabel_exists,cm7_2_code_partition)
	depends on SOC_S32K358_CM7_0
	help
	  Cortex-M7_0 starts Cortex-M7_2 at PRE_KERNEL_2, once the clock tree is configured,
	  from the vector table at the start of the cm7_2_code_partition partition. Linker
	  memory regions in system SRAM outside this image's SRAM (memory shared with
	  Cortex-M7_2, such as IPC buffers) are zeroed with 64-bit writes before, which
	  initializes their ECC.

config IVT_HEADER_OFFSET
	hex
	depends on SOC_S32K3_IVT
	default $(sub_hex,$(dt_node_reg_addr_int,$(dt_nodelabel_path,ivt_header)), \
		$(dt_chosen_reg_addr_int,$(DT_CHOSEN_Z_FLASH)))
	help
	  The offset address from flash base address for ivt header

config IVT_HEADER_SIZE
	hex
	depends on SOC_S32K3_IVT
	default $(dt_node_reg_size_hex,$(dt_nodelabel_path,ivt_header))
	help
	  Size of ivt header region

endif # SOC_SERIES_S32K3
